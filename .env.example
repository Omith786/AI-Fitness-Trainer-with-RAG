# Copy this file to .env and adjust as needed. Every value has a default, so the
# app runs with no configuration against a local Ollama server.

# HTTP server
HOST=127.0.0.1
PORT=8080

# Language model (any OpenAI-compatible chat completions endpoint).
# Default targets a local Ollama server: install from https://ollama.com and run
#   ollama pull qwen2.5:1.5b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# Example: free-tier Groq (get a key at https://console.groq.com, then set)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.1-8b-instant

# Example: Google Gemini via its OpenAI-compatible endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-1.5-flash

# Embeddings (Transformers.js model id; downloaded and cached on first run)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Retrieval tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVAL_CANDIDATES=8
RETRIEVAL_TOP_K=4

# Paths (defaults are usually fine)
KNOWLEDGE_BASE_DIR=data/knowledge_base
INDEX_PATH=data/index.json
WEB_DIST_DIR=web/dist

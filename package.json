{
  "name": "ai-fitness-trainer-with-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A retrieval-augmented fitness assistant that grounds workout and nutrition advice in a curated knowledge base and cites its sources.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build:index": "tsx src/index/build.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "build": "npm run build:web",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm --workspace web run typecheck"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@huggingface/transformers": "^3.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
